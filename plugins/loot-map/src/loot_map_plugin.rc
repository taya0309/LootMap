#include <D2RLPlugin/resource.h>
#include <D2RLPlugin/version.h>

// D2RLoader 需要的插件清单资源（缺了它插件不会被加载）。
//
// 这里刻意不使用 D2RL_PLUGIN_ABI_VERSION（那是 4），而是写 3：
// ABI 4 相对 ABI 3 只多了 HTTPS 服务，本插件用不到；
// 而现役 D2RLoader 1.2.1-beta 里正常工作的插件声明的都是 ABI 2 / 3。
// 声明 3 可以同时被 1.2.x 与以后的 1.3.x+ 加载。
// 注意：这个值必须与 src/loot_map_plugin.cpp 里的 kPluginAbiVersion 保持一致。
#define LOOT_MAP_DECLARED_ABI_VERSION 3

D2RL_PLUGIN_MANIFEST_RESOURCE_ID RCDATA { D2RL_PLUGIN_RESOURCE_DWORD(LOOT_MAP_DECLARED_ABI_VERSION) }
